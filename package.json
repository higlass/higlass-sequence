{
  "name": "higlass-sequence",
  "version": "0.4.2",
  "description": "Sequence tracks for HiGlass",
  "private": false,
  "author": "Alexander Veit",
  "license": "MIT",
  "contributors": [
    {
      "name": "Alexander Veit",
      "url": "http://github.com/alexander-veit"
    }
  ],
  "main": "./src/index.js",
  "unpkg": "./dist/higlass-sequence.js",
  "module": "./es",
  "files": [
    "dist",
    "es"
  ],
  "repository": "github:higlass/higlass-sequence",
  "devDependencies": {
    "@babel/cli": "^7.0.0",
    "@babel/core": "^7.15.8",
    "@babel/preset-env": "^7.15.8",
    "@babel/preset-react": "^7.14.5",
    "@wojtekmaj/enzyme-adapter-react-17": "^0.6.7",
    "autoprefixer": "^10.4.20",
    "babel-loader": "^8.2.2",
    "babel-polyfill": "^6.26.0",
    "chai": "^4.2.0",
    "cheerio": "1.0.0-rc.10",
    "enzyme": "^3.11.0",
    "fetch-mock": "^12.2.0",
    "file-loader": "^6.2.0",
    "fs-extra": "^8.1.0",
    "higlass": "^1.13.4",
    "html-loader": "^5.1.0",
    "html-webpack-plugin": "^5.6.3",
    "i": "^0.3.7",
    "jasmine": "^2.99.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.1.0",
    "karma-jasmine": "^3.1.1",
    "karma-server-side": "^1.7.0",
    "karma-sourcemap-loader": "^0.3.7",
    "karma-verbose-reporter": "0.0.6",
    "karma-webpack": "^5.0.1",
    "sourcemap": "^0.1.0",
    "terser-webpack-plugin": "^3.0.1",
    "unminified-webpack-plugin": "^3.0.0",
    "webpack": "^5.97.1",
    "webpack-cli": "^4.10.0",
    "webpack-dev-server": "^4.3.1"
  },
  "scripts": {
    "build-es": "rm -rf ./es/* && npx babel ./src/scripts/ --out-dir ./es/ --env-name esm",
    "build": "npm run build-es && NODE_ENV=production ./node_modules/webpack/bin/webpack.js --mode production",
    "build-debug": "NODE_ENV=development; ./node_modules/webpack/bin/webpack.js --mode=development",
    "start": "./node_modules/webpack-dev-server/bin/webpack-dev-server.js --mode development --open",
    "test": "NODE_ENV=development; npm run build-debug && ./node_modules/karma/bin/karma start karma.conf.js",
    "prerelease": "rm -rf dist/*; npm run build; zip -r dist.zip dist"
  },
  "dependencies": {
    "@gmod/indexedfasta": "^2.0.0",
    "css-loader": "^7.1.2",
    "d3-color": "^3.1.0",
    "d3-dsv": "^3.0.1",
    "d3-scale": "^4.0.2",
    "d3-scale-chromatic": "^3.0.0",
    "generic-filehandle": "^3.0.0",
    "higlass-register": "^0.3.0",
    "slugid": "^3.0.0",
    "style-loader": "^4.0.0"
  }
}
